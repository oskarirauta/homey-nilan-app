{
  "id": "nilan_set_central_heating_temperature",
  "title": {
    "en": "Set central heating temperature"
  },
  "titleFormatted": {
    "en": "Set central heating temperature to [[temperature]]"
  },
  "hint": {
    "en": "Set the central heating temperature setpoint."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=CTS602&capabilities=target_temperature.ek"
    },
    {
      "name": "temperature",
      "type": "range",
      "title": {
        "en": "Central heating temperature"
      },
      "min": 5,
      "max": 50,
      "step": 0.5,
      "label": "°C",
      "labelMultiplier": 1,
      "labelDecimals": 1
    }
  ]
}
