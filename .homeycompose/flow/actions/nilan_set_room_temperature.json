{
  "id": "nilan_set_room_temperature",
  "title": {
    "en": "Set room temperature"
  },
  "titleFormatted": {
    "en": "Set room temperature to [[temperature]]"
  },
  "hint": {
    "en": "Set the indoor temperature setpoint."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=CTS602&capabilities=target_temperature"
    },
    {
      "name": "temperature",
      "type": "range",
      "min": 5,
      "max": 30,
      "step": 0.5,
      "label": "°C",
      "labelMultiplier": 1,
      "labelDecimals": 1
    }
  ]
}
